{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buyer-hunter.local/contracts/sales-intelligence-connector-v1.schema.json",
  "title": "Buyer Hunter Sales Intelligence Connector Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "category_code", "buyer", "demand", "truth", "enrichment", "exported_at"],
  "properties": {
    "schema_version": {"const": "sales-intelligence-connector-v1"},
    "signal_id": {"type": ["string", "null"]},
    "category_code": {"enum": ["MATCHA", "BLUEBERRY", "ROSA_ROXBURGHII", "CHILI", "TEA", null]},
    "product_terms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hs_codes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4,10}$"}, "uniqueItems": true},
    "buyer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "country_code"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "domain": {"type": ["string", "null"]},
        "country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "canonical_company_id": {"type": ["string", "null"]},
        "parent_company_id": {"type": ["string", "null"]},
        "subsidiary_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "published_at", "source_url"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "published_at": {"type": ["string", "null"], "format": "date"},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "quantity": {"type": ["number", "null"], "minimum": 0},
        "quantity_unit": {"type": ["string", "null"]},
        "delivery_country_code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "required_standards": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_specifications": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "dimensions"],
      "properties": {
        "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "level": {"enum": ["A", "B", "C", "D", null]},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "d1_demand_explicitness": {"type": ["integer", "null"], "minimum": 0, "maximum": 35},
            "d2_entity_authenticity": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
            "d3_recency": {"type": ["integer", "null"], "minimum": 0, "maximum": 25},
            "d4_corroboration": {"type": ["integer", "null"], "minimum": 0, "maximum": 15}
          }
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trade_activity": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {"enum": ["trademo", "volza", null]},
            "first_shipment_at": {"type": ["string", "null"], "format": "date"},
            "last_shipment_at": {"type": ["string", "null"], "format": "date"},
            "shipment_count_90d": {"type": ["integer", "null"], "minimum": 0},
            "shipment_count_365d": {"type": ["integer", "null"], "minimum": 0},
            "volume_trend": {"enum": ["up", "flat", "down", "unknown", null]},
            "supplier_switch_detected": {"type": ["boolean", "null"]},
            "source_record_ids": {"type": "array", "items": {"type": "string"}}
          }
        },
        "entity": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {"type": ["string", "null"]},
            "provider_company_id": {"type": ["string", "null"]},
            "legal_name": {"type": ["string", "null"]},
            "domain": {"type": ["string", "null"]},
            "employee_count": {"type": ["integer", "null"], "minimum": 0},
            "industry": {"type": ["string", "null"]}
          }
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "provider": {"type": "string"},
              "name": {"type": ["string", "null"]},
              "title": {"type": ["string", "null"]},
              "business_email": {"type": ["string", "null"], "format": "email"},
              "business_phone": {"type": ["string", "null"]},
              "linkedin_url": {"type": ["string", "null"], "format": "uri"},
              "verification_status": {"enum": ["verified", "unverified", "suppressed", "unknown"]}
            }
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "provider": {"type": ["string", "null"]},
            "topic": {"type": ["string", "null"]},
            "score": {"type": ["number", "null"], "minimum": 0},
            "tier": {"type": ["string", "null"]},
            "observed_at": {"type": ["string", "null"], "format": "date-time"},
            "availability": {"enum": ["api", "approved_export", "ui_only", "unavailable", null]}
          }
        },
        "recommended_action": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "opportunity_score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "why_now": {"type": ["string", "null"]},
            "next_action": {"type": ["string", "null"]},
            "clay_delivery_status": {"enum": ["not_sent", "dry_run", "sent", "failed", null]}
          }
        }
      }
    },
    "exported_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "observed_at", "claim"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date-time"},
        "claim": {"type": "string"},
        "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
